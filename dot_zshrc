# ~/.zshrc — managed by chezmoi (edit via `chezmoi edit ~/.zshrc`, then `chezmoi apply`)

# ---- PATH -------------------------------------------------------------------
typeset -U path PATH   # de-duplicate entries
path=("$HOME/.local/bin" "$HOME/.pixi/bin" $path)
[[ -d "$HOME/.codex/bin" ]] && path=("$HOME/.codex/bin" $path)
export PATH

# ---- History ----------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY          # share across concurrent shells (tmux panes)
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE      # leading space -> not recorded (for secrets)
setopt HIST_REDUCE_BLANKS
setopt EXTENDED_HISTORY       # record timestamps

# ---- Options ----------------------------------------------------------------
setopt AUTO_CD                # `..` or a dir name cd's into it
setopt INTERACTIVE_COMMENTS   # allow # comments on the command line
setopt NO_BEEP

# ---- Completion -------------------------------------------------------------
mkdir -p "$HOME/.cache/zsh"
autoload -Uz compinit
compinit -d "$HOME/.cache/zsh/zcompdump"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ---- Keybindings ------------------------------------------------------------
bindkey -e                    # emacs mode (Ctrl-A/E, Alt-B/F, ...)
# Up/Down: search history for what's already typed (prefix search)
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
# Delete words like bash does (stop at / and -)
autoload -Uz select-word-style
select-word-style bash

# ---- Aliases ----------------------------------------------------------------
[[ -f "$HOME/.config/zsh/aliases.zsh" ]] && source "$HOME/.config/zsh/aliases.zsh"

# ---- Plugins (installed by chezmoi externals, pinned) -----------------------
ZPLUG="$HOME/.local/share/zsh/plugins"
[[ -f "$ZPLUG/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] \
    && source "$ZPLUG/zsh-autosuggestions/zsh-autosuggestions.zsh"
# syntax-highlighting must be sourced last
[[ -f "$ZPLUG/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] \
    && source "$ZPLUG/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# ---- Tools ------------------------------------------------------------------
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v pixi     >/dev/null && eval "$(pixi completion --shell zsh)"

# conda: lazy-load so shells start fast; first `conda` call pays the init cost.
# Only defined on machines that actually have /opt/conda.
if [[ -f /opt/conda/etc/profile.d/conda.sh ]]; then
    conda() {
        unfunction conda
        source /opt/conda/etc/profile.d/conda.sh
        conda "$@"
    }
fi
