# ~/.profile — managed by chezmoi. Read by POSIX/bash LOGIN shells (not by
# bash if ~/.bash_profile exists — don't create one). ~/.zshenv sources it too,
# so the exports below reach zsh as well. Keep it to plain exports.
#
# Why here: VS Code resolves the "local" environment for devcontainer.json's
# ${localEnv:...} by running the user's LOGIN shell on the host — /bin/bash on
# dgx1 — so ~/.zshenv alone is never seen there.

# --- Ubuntu default (kept verbatim) -----------------------------------------
if [ -n "$BASH_VERSION" ]; then
    if [ -f "$HOME/.bashrc" ]; then
        . "$HOME/.bashrc"
    fi
fi
if [ -d "$HOME/bin" ] ; then
    PATH="$HOME/bin:$PATH"
fi
if [ -d "$HOME/.local/bin" ] ; then
    PATH="$HOME/.local/bin:$PATH"
fi

# --- Per-host values for the devcontainer baseline ---------------------------
# Project devcontainer.json files read these as ${localEnv:TF_*:default}.
# EVERY known host exports its values explicitly — even when they happen to
# match a file's fallbacks — so projects are free to choose their own
# fallbacks, and a broken resolution path is visible on every host (see the
# baseline README, "Per-host values" and the canary under failure modes).
# Inside containers no branch matches — harmless.
{{- /* .chezmoi.hostname can be reverse-DNS-canonicalized (dgx1 becomes
      localhost6); the hostname command returns the machine's configured name. */}}
{{- $hostname := output "hostname" | trim }}
{{- if eq $hostname "iota" }}
export TF_UID=1001
export TF_GID=1001
export TF_DATA_GID=100
export TF_DATA_GID2=100
export TF_DATA_ROOT=/mnt/data
{{- else if hasPrefix "dgx1" $hostname }}
export TF_UID=1005
export TF_GID=1005
export TF_DATA_GID=1002
export TF_DATA_GID2=1003
export TF_DATA_ROOT=/mnt/data/hegemon
{{- else if eq $hostname "pontus" }}
# TODO(pontus): fill in before first devcontainer build on this host —
# `id -u` / `id -g`, `stat -c '%g' <data mount>` (twice if only one group),
# and the data root; add TF_SHM_SIZE if 64g doesn't fit the machine.
# export TF_UID=
# export TF_GID=
# export TF_DATA_GID=
# export TF_DATA_GID2=
# export TF_DATA_ROOT=
{{- end }}
