# ~/.zshenv — managed by chezmoi. Read by EVERY zsh, so keep it minimal.
# The per-host TF_* exports for the devcontainer baseline live in ~/.profile
# (bash login shells, which is what VS Code uses to resolve ${localEnv:...});
# source it here so zsh sessions and zsh-login hosts see the same values.
[ -f "$HOME/.profile" ] && emulate sh -c '. "$HOME/.profile"'
