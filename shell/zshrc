# Shared interactive-shell config, sourced from ~/.zshrc (the devcontainer
# postCreate appends the source line; usable on hosts the same way).
# Works with plain `docker exec` shells, VS Code terminals, and tmux panes.

# --- prompt: user@host, cwd, git branch, exit-status colored arrow ----------
# The container sets --hostname (e.g. tileforge-dev), so %m tells you at a
# glance whether the shell is inside the sandbox or on the host.
autoload -Uz vcs_info
setopt prompt_subst
zstyle ':vcs_info:git:*' formats ' %F{magenta}%b%f'
precmd() { vcs_info }
PROMPT='%F{cyan}%n@%m%f %F{blue}%~%f${vcs_info_msg_0_} %(?.%F{green}.%F{red})❯%f '

# --- history: persisted in the dotfiles checkout (survives container
# rebuilds; .zsh_history.local is gitignored) --------------------------------
HISTFILE="${${(%):-%x}:A:h:h}/.zsh_history.local"
HISTSIZE=50000
SAVEHIST=50000
setopt share_history hist_ignore_dups hist_ignore_space

# --- completion -------------------------------------------------------------
autoload -Uz compinit && compinit -u

# --- quality of life --------------------------------------------------------
alias ll='ls -lah'
alias gs='git status -sb'

# Attach-or-create the main tmux work session. Inside it, panes are full
# login shells (venv active, claude/codex on PATH) — start `claude` in a
# pane and it keeps running after you detach (prefix+d) or disconnect.
alias dev='tmux new-session -A -s dev'
